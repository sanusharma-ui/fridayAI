{
  "expo": {
    "name": "Friday Assistant",
    "slug": "friday-assistant-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141615",
    "splash": {
      "backgroundColor": "#141615"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.friday.assistant",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Friday to attach images from your photo library for visual analysis.",
        "NSContactsUsageDescription": "Allow Friday to search and save contacts in your phonebook.",
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "upi",
          "gpay",
          "phonepe",
          "paytmmp"
        ]
      }
    },
    "android": {
      "package": "com.friday.assistant",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#141615"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Friday to search and save contacts in your phonebook."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Friday to attach photos for AI analysis."
        }
      ]
    ]
  }
}
