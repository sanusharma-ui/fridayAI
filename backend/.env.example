# Server port (0.0.0.0 binding allows LAN access from your mobile device)
PORT=4000

# Optional fallback Groq API key.
# Leave empty so users set up their own Groq API keys from the Mobile App Settings window!
GROQ_API_KEY=

# Optional default models
DEFAULT_TEXT_MODEL=llama-3.3-70b-versatile
DEFAULT_VISION_MODEL=qwen/qwen3.8-27b
